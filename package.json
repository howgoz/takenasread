{
  "name": "taken-as-read",
  "version": "1.0.0",
  "private": true,
  "description": "Taken as Read Photography",
  "scripts": {
    "build:images": "node scripts/build-images.js",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --minify",
    "build": "npm run build:images && npm run build:css",
    "dev": "npm run build:images && tailwindcss -i ./css/input.css -o ./css/styles.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howgoz/takenasread.git"
  },
  "license": "ISC",
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
